# Schedules mealbot-docker-cleanup.service once a week.
#
# This is the unit you enable:
#   systemctl enable --now mealbot-docker-cleanup.timer
#
# See deploy/systemd/README.md.

[Unit]
Description=Schedule the mealbot weekly Docker disk reclamation job
Documentation=https://github.com/fatheus97/mealbot/blob/main/deploy/systemd/README.md

[Timer]
# Weekly on Sunday at 04:30 server-local time. Weekly (not daily) because build
# cache accrues per deploy, not per day, and a fresh-cache rebuild costs a slow
# deploy — no need to pay that daily. Off-peak, and an hour clear of the daily
# 03:30 authsession-cleanup timer (and well clear of the 08:00 billing timer) so
# the three never contend for the small Hetzner box at once. The job is
# idempotent (a second run finds little/nothing to reclaim), so an occasional
# double/missed run is harmless.
OnCalendar=Sun *-*-* 04:30:00
# If the box was powered off at the scheduled time, run as soon as it's back up
# so a reboot or maintenance window doesn't silently skip a week's cleanup — the
# scenario where disk is most likely to have crept up.
Persistent=true
# Small jitter so this doesn't fire at the exact same instant as any other timer
# competing for the box.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
