# Schedules mealbot-embedding-backfill.service once a day.
#
# This is the unit you enable (unit-sync does it for you, see README §7):
#   systemctl enable --now mealbot-embedding-backfill.timer
#
# See deploy/systemd/README.md.

[Unit]
Description=Schedule the mealbot daily cookbook-embedding backfill job
Documentation=https://github.com/fatheus97/mealbot/blob/main/deploy/systemd/README.md

[Timer]
# 05:00 server-local time: after every other nightly job (02:30 backup through
# Sunday's 04:30 Docker cleanup), so the model load never competes with them
# for the small box. Idempotent, so a missed or doubled run is harmless.
OnCalendar=*-*-* 05:00:00
# If the box was off at 05:00, run once it is back.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
