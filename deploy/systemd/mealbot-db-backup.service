# mealbot — nightly Postgres dump.
#
# Runs scripts/db-backup.sh once, then exits (Type=oneshot). Scheduled by
# mealbot-db-backup.timer; installable/testable on its own via
# `systemctl start mealbot-db-backup.service`.
#
# Deliberately has NO [Install] section: it must run ONLY when the timer (or an
# operator) triggers it, never at boot. Enable the .timer, not this unit.
#
# See deploy/systemd/README.md for install steps and the restore rehearsal.

[Unit]
Description=mealbot nightly Postgres dump
Documentation=https://github.com/fatheus97/mealbot/blob/main/deploy/systemd/README.md
# Docker must be up before we shell out to `docker compose`. This matters for
# the timer's Persistent=true catch-up run after a reboot, where the timer can
# fire before the Docker daemon is ready.
Requires=docker.service
After=docker.service
# A backup that fails silently is the worst unit on the box: you find out it was
# broken at the exact moment you need it. Alert loudly.
OnFailure=mealbot-alert@%n.service

[Service]
Type=oneshot
# Same non-root, docker-group user as the sibling units. The dump is written to
# BACKUP_DIR, which must therefore be writable by `deploy` (see README §4).
User=deploy
WorkingDirectory=/opt/mealbot
# `exec` (not `run --rm`) deliberately: pg_dump must talk to the RUNNING
# postgres, and a one-off container would start a second, empty database rather
# than dumping the live one. If the db container is down the unit fails, which
# is correct — that is a real failure worth an alert, not a no-op.
ExecStart=/opt/mealbot/scripts/db-backup.sh
# Generous: the dump is small today but grows with the plan/recipe tables, and
# a slow disk under load must not truncate a backup. The script's own atomic
# rename means a timeout leaves a .partial file, never a bad backup.
TimeoutStartSec=1800
