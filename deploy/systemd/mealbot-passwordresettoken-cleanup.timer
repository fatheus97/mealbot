# Schedules mealbot-passwordresettoken-cleanup.service once a day.
#
# This is the unit you enable:
#   systemctl enable --now mealbot-passwordresettoken-cleanup.timer
#
# (In practice sync-systemd-units.sh enables it for you the first time the file
# lands on the box — it enables NEW timers and leaves deliberately-disabled ones
# alone. The command above is for a box rebuild.)
#
# See deploy/systemd/README.md.

[Unit]
Description=Schedule the mealbot daily expired-password-reset-token cleanup job
Documentation=https://github.com/fatheus97/mealbot/blob/main/deploy/systemd/README.md

[Timer]
# 04:00, keeping the established 30-minute stagger: db-backup 02:30, offsite
# 03:00, authsession 03:30, this 04:00, docker-cleanup Sun 04:30, billing 08:00.
# Nothing here contends for the small Hetzner box at once. The job is idempotent
# (a second run finds nothing to delete), so an occasional double or missed run
# is harmless.
OnCalendar=*-*-* 04:00:00
# If the box was powered off at 04:00, run as soon as it's back up so a reboot
# or maintenance window doesn't silently skip a day's sweep.
Persistent=true
# Small jitter so this doesn't fire at the exact same instant as any other
# timer competing for the box.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
