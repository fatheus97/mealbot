<?xml version="1.0" encoding="UTF-8"?>
<!--
  Both marketing locales, each declaring the FULL alternate set including
  itself. That self-reference is not redundant: Google treats a sitemap
  hreflang group as a bidirectional claim and drops the group entirely if any
  page in it fails to name every member, exactly as it does for the in-page
  <link rel="alternate"> tags. The two annotations say the same thing twice on
  purpose — either one alone is enough, and having both survives one of them
  being edited away.

  Only the marketing pages are listed. /app is the SPA behind a login and
  /privacy + /terms are linked from every page but are not search entry points
  worth competing for.
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
>
  <url>
    <loc>https://trymealbot.com/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://trymealbot.com/" />
    <xhtml:link rel="alternate" hreflang="cs" href="https://trymealbot.com/cs" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://trymealbot.com/" />
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://trymealbot.com/cs</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://trymealbot.com/" />
    <xhtml:link rel="alternate" hreflang="cs" href="https://trymealbot.com/cs" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://trymealbot.com/" />
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
